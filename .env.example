# Safe local examples only. Never commit real credentials.
CONTROLPROOF_TARGET_ID=whyyou-local
CONTROLPROOF_ENVIRONMENT_KIND=LOCAL_EMULATED
CONTROLPROOF_AWS_DEPLOYMENT_STATUS=NOT_RUN
CONTROLPROOF_RUN_ROOT=.controlproof/runs
CONTROLPROOF_FAULT_ROOT=.controlproof/faults
CONTROLPROOF_OBSERVER_ROOT=.controlproof/observers
CONTROLPROOF_TEST_HOOKS_ENABLED=true
CONTROLPROOF_OBSERVER_ENABLED=true
CONTROLPROOF_MODEL_SUBSTITUTE_ENABLED=true
CONTROLPROOF_MODEL_FIXTURE_ID=h03-report-v1
CONTROLPROOF_MODEL_FIXTURE_DIGEST=ce09b95403b34e1390502c90f5c5edc518ddf65d38c8ce881617a37cac6d16b1
CONTROLPROOF_EMBEDDING_FIXTURE_ID=h03-embedding-v1
CONTROLPROOF_EMBEDDING_FIXTURE_DIGEST=ce09b95403b34e1390502c90f5c5edc518ddf65d38c8ce881617a37cac6d16b1
# Spec 004 (E-01/E-02): switch BOTH repositories' .env to the spec004 fixture, then restart the
# WhyYou API and all four workers (Spec 004 quickstart, fixture switch). Switch back to the h03
# values above before any N-02/H-03 Run. The embedding fixture is unchanged.
# CONTROLPROOF_MODEL_FIXTURE_ID=spec004-report-v1
# CONTROLPROOF_MODEL_FIXTURE_DIGEST=e15ec3790b64b2fba10e0caa9372f08c917edbbaa99ce308076952b838668b3f
# The E-02 scoring-rule pins (WhyYou scoring.py/report.py blob SHAs) are code constants with no
# override variable: a drifted target is RUNNER_NOT_READY, never silently accepted.
CONTROLPROOF_EXTERNAL_AI_ALLOWED=false
WHYYOU_BASE_URL=http://localhost:8080
WHYYOU_CONSOLE_URL=http://localhost:5173
WHYYOU_DATABASE_URL=postgresql+psycopg://local-user:local-password@localhost:5432/local-test
WHYYOU_COMPANY_TOKEN=replace-with-local-test-token
WHYYOU_COMPANY_ID=00000000-0000-7000-8000-000000000001
WHYYOU_COMPANY_USER_ID=00000000-0000-7000-8000-000000000002
WHYYOU_REPO_PATH=../gbsa_aws
WHYYOU_AWS_ENDPOINT_URL=http://localhost:4566
WHYYOU_AWS_REGION=ap-northeast-2
WHYYOU_REPORTING_QUEUE_NAME=iep-reporting
WHYYOU_REPORTING_DLQ_NAME=iep-reporting-dlq
WHYYOU_REPORTING_MAX_RECEIVE_COUNT=3
WHYYOU_REPORTING_VISIBILITY_TIMEOUT_SECONDS=5
